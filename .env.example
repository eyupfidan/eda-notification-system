# Optional overrides for docker-compose.yml.
# Copy to .env only if you want to change a default; `docker compose up` works without it.

APP_NAME="EDA Notification System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=notifications
DB_USERNAME=notifications
DB_PASSWORD=secret
# Host port for connecting to PostgreSQL from your machine (e.g. a DB client)
DB_FORWARD_PORT=54320

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=array

# Number of queue worker containers
WORKER_REPLICAS=2

# External notification provider (simulated with webhook.site).
# Create your own URL at https://webhook.site and configure it to return:
#   status 202, application/json,
#   {"messageId": "<uuid>", "status": "accepted", "timestamp": "<ISO8601>"}
NOTIFICATION_PROVIDER_URL=

# Host port of the WebSocket server (Laravel Reverb)
REVERB_PUBLIC_PORT=8085

# Distributed tracing (OpenTelemetry → Jaeger UI on JAEGER_UI_PORT)
OTEL_ENABLED=true
JAEGER_UI_PORT=16686

# Delivery tuning (defaults shown)
NOTIFICATION_RATE_LIMIT_PER_SECOND=100
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_DELAY=10
NOTIFICATION_CB_THRESHOLD=10
NOTIFICATION_CB_COOLDOWN=30

# Local mock provider (`make up-mock`): probabilities between 0 and 1
MOCK_FAILURE_RATE=0
MOCK_RATE_LIMIT_RATE=0
MOCK_TIMEOUT_RATE=0
MOCK_LATENCY_MS=20-80
